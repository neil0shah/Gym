# Copy this file to fly.toml and replace YOUR-APP-NAME with the name you
# chose when you ran `fly apps create`. See README.md for the full walkthrough.
app = "YOUR-APP-NAME"
primary_region = "iad"

[build]

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

[mounts]
  source = "gym_data"
  destination = "/app/data"
